# PostgreSQL (shared by lottery and user services)
DB_URL=jdbc:postgresql://localhost:5432/lottery
DB_USERNAME=lottery
DB_PASSWORD=lottery
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_TRANSACTION_TIMEOUT_SECONDS=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_POOL_MAX_ACTIVE=32
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=4
REDIS_POOL_MAX_WAIT=2s

# RabbitMQ
MQ_HOST=localhost
MQ_PORT=5672
MQ_USERNAME=lottery
MQ_PASSWORD=lottery
MQ_VHOST=/
MQ_PREFETCH=20
MQ_CONCURRENCY=3
MQ_MAX_CONCURRENCY=10
MQ_RETRY_MAX_ATTEMPTS=3
MQ_RETRY_INITIAL_INTERVAL=1s

# Lottery draw
DRAW_MAX_BATCH_DRAWS=100
DRAW_PROBABILITY_SCALE=10000000
DRAW_IDEMPOTENCY_TTL=24h
DRAW_RESULT_TTL=24h
DRAW_SSE_TIMEOUT=5m
DRAW_SSE_POLL_INTERVAL=500ms

# Lottery messaging
LOTTERY_EXCHANGE=lottery.exchange
LOTTERY_QUEUE=lottery.draw.queue
LOTTERY_ROUTING_KEY=lottery.draw.requested
LOTTERY_DLX=lottery.dlx
LOTTERY_DLQ=lottery.draw.dlq
LOTTERY_DLQ_ROUTING_KEY=lottery.draw.dead
LOTTERY_OUTBOX_POLL_INTERVAL_MS=1000

# Swagger
SWAGGER_API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/lottery
KEYCLOAK_AUDIENCE=user-service
KEYCLOAK_BACKEND_CLIENT_ID=user-service
# TODO: Replace with the actual secret generated by the Keycloak user-service client.
KEYCLOAK_BACKEND_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_FRONTEND_CLIENT_ID=lottery-web
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8081/realms/lottery/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=http://localhost:8081/realms/lottery/protocol/openid-connect/token
KEYCLOAK_FRONTEND_REDIRECT_URI=http://localhost:3000/callback
